# Copy to .env and edit. Never commit .env.
# The browser demo reads ANTHROPIC_* and ENGLISH_DIFFICULTY.
# Visitors do not set a key. Leave ANTHROPIC_API_KEY empty for the local tutor.

# --- Browser demo (`npm run web`) ---
# Platforms set PORT. Local default is 47821.
WEB_PORT=47821
# Set true behind Fly, Railway, Render, or another reverse proxy.
WEB_TRUST_PROXY=false
WEB_COOKIE_SECURE=false

# --- Minecraft server ---
# Local Paper server from `npm run server` uses these defaults.
MC_HOST=127.0.0.1
MC_PORT=25565
# Offline names: 3-16 letters, numbers, or underscores. This is the name players see.
MC_USERNAME=Maple
# offline: cracked / online-mode=false servers, including the local server script.
# microsoft: premium online-mode=true servers. First launch prints a device-login code.
MC_AUTH=offline
# Pin a Mineflayer-supported version. 1.21.4 is the tested target.
# Set MC_VERSION=auto to let Mineflayer detect the server.
# Mineflayer 4.39 also lists 1.21.11 and 26.1. It does not list Paper 26.2 / 26.3.
MC_VERSION=1.21.4
# Optional. If set, Maple only answers these players (comma-separated).
MC_PLAYER=
# Say a short hello when Maple joins.
MC_GREET=true
# Dig-three-stones tutorial. Off by default. Maple only — Spark ignores this.
# DIG_STONE_QUEST=1
# QUEST=digstone
# Also: QUEST=dig_stone or QUEST=digStone. See docs/dig-stone-quest.md.
# Do not put API keys in this quest flag.
# Reconnect attempts after a disconnect.
MC_RECONNECTS=3

# --- Chat limits ---
# chat: everyone nearby sees the English practice. whisper: only the player you answer.
CHAT_MODE=chat
# Minecraft chat allows 256 characters. Shorter lines are easier to read.
CHAT_MAX_LINE_CHARS=180
CHAT_MAX_LINES=3
# Minimum gap between Maple's chat lines, and between a player's turns.
CHAT_MIN_INTERVAL_MS=900
PLAYER_MIN_INTERVAL_MS=1200
# Shared cap so a busy server cannot drain the Claude API.
GLOBAL_TURNS=6
GLOBAL_WINDOW_MS=30000

# --- English ---
# beginner or intermediate. Players can change this in chat.
ENGLISH_DIFFICULTY=beginner
# How many previous player/Maple pairs to send to Claude.
HISTORY_TURNS=8

# --- Anthropic Claude ---
# Leave empty to use the built-in local tutor (no network). Replies are still English.
ANTHROPIC_API_KEY=
# Claude Opus 5.5 on the Claude API. Fixed id, no date suffix.
# https://platform.claude.com/docs/en/models/opus-5-5/overview
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking is always on for this model. max_tokens covers thinking plus the reply.
ANTHROPIC_MAX_TOKENS=2048
# low keeps Minecraft replies cheap and fast. Also: medium, high, xhigh, max.
ANTHROPIC_EFFORT=low


# --- OpenAI (typed chat / tutor) ---
# When OPENAI_API_KEY is set and OPENAI_TYPED=1, web + Java typed chat use OpenAI.
# Leave empty to fall back to Anthropic (if set) or the local practice tutor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_MAX_TOKENS=512
OPENAI_TYPED=1
# GPT Live (Java mic): server stubs exist in voiceCompanion, but companion.js is Doubao-only.
# 1 = Java mic uses GPT Live WebRTC via /api/session. 0 = Doubao WS fallback.
OPENAI_LIVE=1
# Local Clash/V2Ray proxy (Node fetch cannot reach api.openai.com without it on this Mac)
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# OPENAI_LIVE_MODEL=gpt-live-1
# OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-terra

# --- Doubao realtime voice (豆包端到端实时语音) ---
# Classroom voice is the Java bot (`npm start`), plus the local mic window.
# Default mic page: http://127.0.0.1:47822  (VOICE_PORT / VOICE_HOST)
# Keep VOICE_HOST on 127.0.0.1. Keys stay in this process. The page never sees them.
# The browser voxel demo (`npm run web`) is for typing. It is not the Java client.
# VOICE_COMPANION=false skips the mic window. In-game chat still works.
# Leave the Doubao keys empty and Maple still answers typed chat with the local tutor.
#
# Free trial:
# 1. Open https://console.volcengine.com/speech/app
# 2. Create or open a speech app. Open 豆包语音 / 端到端实时语音.
# 3. Click 试用 (Try). The console grants a free trial quota (about 1,000,000 tokens on the speech trial).
# 4. Copy APP ID and Access Token into the variables below.
#    If the console also shows a Secret Key, put it in DOUBAO_SECRET_KEY.
# An APP ID looks like 3496507434. Do not commit the access token.
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
# Optional. Sent only as the X-Api-Key header when the console gives you a secret / API key.
DOUBAO_SECRET_KEY=
# Fixed resource id for realtime dialogue.
DOUBAO_RESOURCE_ID=volc.speech.dialog
# Optional overrides. Defaults speak the Seeduplex duplex protocol, then fall back to the older endpoint.
# DOUBAO_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
# DOUBAO_LEGACY_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
# DOUBAO_MODEL=1.2.6.1
# DOUBAO_VOICE=zh_female_vv_jupiter_bigtts
# VOICE_PORT=47822
# VOICE_HOST=127.0.0.1

# --- Companion persona (duo bots) ---
# maple (default): warm, patient English playmate.
# spark: energetic, playful, slightly teasing. Use with MC_USERNAME=Spark.
# COMPANION_PERSONA=maple
# MAPLE_PERSONA=maple
# Spark should set VOICE_COMPANION=0 so only Maple owns the mic on 47822.
# npm run start:duo launches Maple + Spark together.
